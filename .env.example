# Copy this file to backend/.env and run uvicorn from the backend/ directory.
#
# Required: Anthropic API key (API-key authentication only).
# Claude subscription credentials are not supported.
ANTHROPIC_API_KEY=

# Directories projects may live under. JSON list.
# Everything outside these roots is rejected by path confinement.
FORGEDESK_WORKSPACE_ROOTS=["/home/you/forgedesk-projects"]

# --- Optional (defaults shown) ---

# SQLite database path (relative to the directory uvicorn is started from)
# FORGEDESK_DATABASE_URL=sqlite:///./forgedesk.db

# Claude model
# FORGEDESK_MODEL=claude-sonnet-4-5

# Run the project's test command inside Docker (network disabled).
# This isolates test commands but does NOT sandbox the agent's Bash tool.
# FORGEDESK_USE_DOCKER=false
# FORGEDESK_DOCKER_IMAGE=python:3.12-slim

# Session limits
# FORGEDESK_MAX_SESSION_MINUTES=45
# FORGEDESK_MAX_TURNS_PER_SESSION=80
# FORGEDESK_MAX_CONSECUTIVE_FAILURES=3

# Backoff between retries
# FORGEDESK_BACKOFF_BASE_SECONDS=5
# FORGEDESK_BACKOFF_MAX_SECONDS=300

# Human-approval timeout for risky commands (seconds). Defaults to "denied" on timeout.
# FORGEDESK_APPROVAL_TIMEOUT_SECONDS=600

# Allowed origins for the CORS middleware (browser -> backend)
# FORGEDESK_CORS_ORIGINS=["http://localhost:5173"]
